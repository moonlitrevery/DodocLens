{
  "author": {
    "name": "DodocLens Team"
  },
  "name": "dodoclens",
  "version": "0.1.0",
  "private": true,
  "description": "Local document intelligence — FastAPI + Electron + React",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:fe": "npm run dev --prefix frontend",
    "dev": "concurrently -k \"npm run dev:fe\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:fe": "npm run build --prefix frontend",
    "electron:prod": "npm run build:fe && electron .",
    "pack": "npm run build:fe && electron-builder --dir",
    "dist": "npm run build:fe && electron-builder",
    "build:installer": "npm run dist",
    "build:desktop": "npm run build:fe && electron-builder --publish never",
    "build:linux": "bash build-linux.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.dodoclens.app",
    "productName": "DodocLens",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "asarUnpack": [
      "**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "**/venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.pyd",
          "!**/data/**",
          "!**/venv/lib/python*/site-packages/torch/test/**",
          "!**/venv/lib/python*/site-packages/torch/share/**",
          "!**/venv/lib/python*/site-packages/torch/benchmarks/**",
          "!**/venv/lib/python*/site-packages/nvidia/**",
          "!**/*.dist-info/RECORD",
          "!**/*.egg-info/**"
        ]
      }
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Office",
      "maintainer": "DodocLens Team",
      "description": "Local-first document intelligence"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}